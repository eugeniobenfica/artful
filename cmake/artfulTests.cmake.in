# Made by CMakeLists.txt from cmake/artfulTests.cmake.in. CTest reads it when it runs, asks artful-tests which tests
# it has (--list), and makes one CTest test of each, run alone (--exact). Exit 77 is a test skipped: what it needs is
# not here.
set(artful_dir "@artful_tests_dir@")
set(artful_found "")
if(CTEST_CONFIGURATION_TYPE AND EXISTS "${artful_dir}/artfulTestsExe-${CTEST_CONFIGURATION_TYPE}.txt")
  set(artful_found "${artful_dir}/artfulTestsExe-${CTEST_CONFIGURATION_TYPE}.txt")
else()
  file(GLOB artful_candidates "${artful_dir}/artfulTestsExe-*.txt")
  if(artful_candidates)
    list(GET artful_candidates 0 artful_found)
  endif()
endif()
set(artful_exe "")
if(artful_found)
  file(READ "${artful_found}" artful_exe)
endif()
if(NOT artful_exe OR NOT EXISTS "${artful_exe}")
  add_test(artful-tests-not-built "${CMAKE_COMMAND}" -E echo "artful-tests is not built")
  set_tests_properties(artful-tests-not-built PROPERTIES WILL_FAIL TRUE)
  return()
endif()
execute_process(COMMAND "${artful_exe}" --list OUTPUT_VARIABLE artful_names RESULT_VARIABLE artful_code)
if(NOT artful_code EQUAL 0)
  add_test(artful-tests-list "${artful_exe}" --list)
  return()
endif()
string(REGEX REPLACE "\r?\n" ";" artful_names "${artful_names}")
foreach(artful_name IN LISTS artful_names)
  if(artful_name)
    add_test("${artful_name}" "${artful_exe}" --exact "${artful_name}")
    set_tests_properties("${artful_name}" PROPERTIES SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${artful_dir}")
  endif()
endforeach()
