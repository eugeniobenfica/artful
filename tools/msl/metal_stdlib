#define ARTF_VEC_TYPES(T)                                   \
    typedef T T##2 __attribute__((ext_vector_type(2)));     \
    typedef T T##3 __attribute__((ext_vector_type(3)));     \
    typedef T T##4 __attribute__((ext_vector_type(4)));
ARTF_VEC_TYPES(float)
ARTF_VEC_TYPES(uint)
ARTF_VEC_TYPES(int)
ARTF_VEC_TYPES(bool)
ARTF_VEC_TYPES(half)

namespace metal {

template <class T, size_t N> struct array {
    T e[N];
    T& operator[](size_t i) { return e[i]; }
    const T& operator[](size_t i) const { return e[i]; }
};

// (a vector or a scalar, flattened: what make_floatN and the like are built of)
#define ARTF_PUT(V, n_)                                                             \
    template <class E> inline void put(E* out, int& n, V v) {                       \
        for (int i = 0; i < n_; ++i) out[n++] = (E)v[i];                            \
    }
template <class E> inline void put(E* out, int& n, float v) { out[n++] = (E)v; }
template <class E> inline void put(E* out, int& n, uint v) { out[n++] = (E)v; }
template <class E> inline void put(E* out, int& n, int v) { out[n++] = (E)v; }
template <class E> inline void put(E* out, int& n, bool v) { out[n++] = (E)v; }
template <class E> inline void put(E* out, int& n, half v) { out[n++] = (E)v; }
ARTF_PUT(float2, 2) ARTF_PUT(float3, 3) ARTF_PUT(float4, 4)
ARTF_PUT(uint2, 2) ARTF_PUT(uint3, 3) ARTF_PUT(uint4, 4)
ARTF_PUT(int2, 2) ARTF_PUT(int3, 3) ARTF_PUT(int4, 4)
ARTF_PUT(bool2, 2) ARTF_PUT(bool3, 3) ARTF_PUT(bool4, 4)
ARTF_PUT(half2, 2) ARTF_PUT(half3, 3) ARTF_PUT(half4, 4)

#define ARTF_MAKE(T, N)                                                             \
    template <class... A> inline T##N make_##T##N(A... a) {                         \
        static_assert(sizeof...(A) >= 1, "a vector of nothing");                    \
        T e[16];                                                                    \
        int n = 0;                                                                  \
        (put<T>(e, n, a), ...);                                                     \
        T##N v;                                                                     \
        for (int i = 0; i < N; ++i) v[i] = n == 1 ? e[0] : e[i];                    \
        return v;                                                                   \
    }
ARTF_MAKE(float, 2) ARTF_MAKE(float, 3) ARTF_MAKE(float, 4)
ARTF_MAKE(uint, 2) ARTF_MAKE(uint, 3) ARTF_MAKE(uint, 4)
ARTF_MAKE(int, 2) ARTF_MAKE(int, 3) ARTF_MAKE(int, 4)
ARTF_MAKE(bool, 2) ARTF_MAKE(bool, 3) ARTF_MAKE(bool, 4)
ARTF_MAKE(half, 2) ARTF_MAKE(half, 3) ARTF_MAKE(half, 4)

struct sampler {};
struct level {
    float v;
    explicit level(float x) : v(x) {}
};
template <class T> struct vec4of;
template <> struct vec4of<float> { typedef float4 type; };
template <> struct vec4of<uint> { typedef uint4 type; };
template <> struct vec4of<int> { typedef int4 type; };
template <class T> struct texture2d {
    typename vec4of<T>::type sample(sampler, float2) const;
    typename vec4of<T>::type sample(sampler, float2, level) const;
    typename vec4of<T>::type read(uint2, uint lod = 0) const;
    uint get_width(uint lod = 0) const;
    uint get_height(uint lod = 0) const;
    uint get_num_mip_levels() const;
};
template <class T> struct texture2d_ms {
    typename vec4of<T>::type read(uint2, uint sample) const;
    uint get_width() const;
    uint get_height() const;
};

template <class T, class F> inline T as_type(F f) {
    static_assert(sizeof(T) == sizeof(F), "as_type of another size");
    return __builtin_bit_cast(T, f);
}

#define ARTF_ONE(name) template <class T> T name(T x);
#define ARTF_TWO(name) template <class T> T name(T a, T b);
